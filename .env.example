# Local dev works with no env vars at all (SQLite file + dev session secret).

# Database. Default: file:local.db (SQLite file in the project root).
# Production (Turso): libsql://<db-name>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Required in production (`next start` / Vercel). At least 32 characters.
# Generate one: openssl rand -base64 32
SESSION_SECRET=
